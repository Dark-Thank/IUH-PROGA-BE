# =============================================================================
# IUH-PROGA SYSTEM - FILE CẤU HÌNH BIẾN MÔI TRƯỜNG TẬP TRUNG BACKEND (.ENV.EXAMPLE)
# Hệ thống Quản lý tiến độ dự án KLTN tích hợp AI Agents
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH FRONTEND (IUH-PROGA-WEB-FE / Next.js)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8082/ws-proga/websocket
NEXT_PUBLIC_APP_NAME="PROGA System"
NEXT_PUBLIC_ENVIRONMENT=development

# -----------------------------------------------------------------------------
# 2. CẤU HÌNH DATABASE (PostgreSQL) & CACHE (Redis)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_HOST=postgres
POSTGRES_PORT_HOST=5433

REDIS_HOST=redis
REDIS_PORT_HOST=6379

# -----------------------------------------------------------------------------
# 3. CẤU HÌNH MICROSERVICES PORTS & EUREKA DISCOVERY SERVER
# -----------------------------------------------------------------------------
EUREKA_SERVER_URL=http://eureka-server:8761/eureka/
EUREKA_PORT=8761

GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
WORKSPACE_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084

# -----------------------------------------------------------------------------
# 4. CẤU HÌNH BẢO MẬT & XÁC THỰC JWT TOKEN
# -----------------------------------------------------------------------------
JWT_SECRET=9a4f2c8d7e1b3a5c7e9f2a4b6c8d1e3f5a7b9c1d3e5f7a9b2c4d6e8f1a3b5c7e
JWT_EXPIRATION_MS=86400000

# -----------------------------------------------------------------------------
# 5. CẤU HÌNH TÍCH HỢP AI AGENTS (Google Gemini API Key)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
